<style>
    .login-page {
        min-height: calc(100vh - 82px);
        background: #f1faf5;
        padding: 70px 6%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .login-page::before {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        background: #dff4e8;
        border-radius: 50%;
        top: -180px;
        left: -160px;
        opacity: 0.7;
    }

    .login-page::after {
        content: "";
        position: absolute;
        width: 500px;
        height: 500px;
        background: #dff4e8;
        border-radius: 50%;
        bottom: -300px;
        right: -180px;
        opacity: 0.65;
    }

    .login-container {
        width: 100%;
        max-width: 1050px;
        min-height: 560px;
        background: #ffffff;
        border-radius: 22px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr 1fr;
        box-shadow: 0 15px 45px rgba(18, 61, 43, 0.12);
        position: relative;
        z-index: 2;
    }

    /* LEFT SIDE */

    .login-welcome {
        background: linear-gradient(145deg, #e7f8ee, #d6f1e1);
        padding: 55px 55px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .login-welcome::before {
        content: "";
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.45);
        top: -130px;
        right: -90px;
    }

    .login-welcome::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.35);
        bottom: -120px;
        left: -100px;
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 35px;
        position: relative;
        z-index: 2;
    }

    .login-brand-logo {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: #108d4b;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
    }

    .login-brand-name {
        color: #087d43;
        font-size: 29px;
        font-weight: 700;
    }

    .login-welcome h1 {
        color: #123d2b;
        font-size: 38px;
        margin: 0 0 18px;
        line-height: 1.15;
        position: relative;
        z-index: 2;
    }

    .login-welcome p {
        color: #426b59;
        font-size: 17px;
        line-height: 1.7;
        max-width: 390px;
        margin: 0;
        position: relative;
        z-index: 2;
    }

    .food-illustration {
        margin-top: 35px;
        width: 230px;
        height: 135px;
        background: #c99a68;
        border-radius: 8px;
        position: relative;
        z-index: 2;
        box-shadow: 0 15px 25px rgba(67, 55, 40, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        margin-right: auto;
    }

    .food-illustration::before {
        content: "🥬  🥕  🍅  🥦";
        position: absolute;
        top: -58px;
        font-size: 43px;
        white-space: nowrap;
    }

    .food-illustration::after {
        content: "♡";
        color: #ffffff;
        font-size: 38px;
    }

    /* RIGHT SIDE */

    .login-form-area {
        padding: 55px 60px;
        display: flex;
        align-items: center;
    }

    .login-form {
        width: 100%;
        max-width: 500px;
        margin: auto;
    }

    .login-form h2 {
        color: #123d2b;
        font-size: 32px;
        margin: 0 0 8px;
    }

    .login-subtitle {
        color: #789087;
        font-size: 15px;
        margin: 0 0 32px;
    }

    .login-field {
        margin-bottom: 22px;
    }

    .login-field label {
        display: block;
        color: #173d2d;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: #6f897d;
        pointer-events: none;
    }

    .login-field input {
        width: 100%;
        height: 52px;
        border: 1px solid #ccd9d2;
        border-radius: 10px;
        padding: 0 16px 0 48px;
        font-size: 15px;
        color: #173d2d;
        outline: none;
        transition: 0.2s ease;
        background: #ffffff;
    }

    .login-field input:focus {
        border-color: #108d4b;
        box-shadow: 0 0 0 3px rgba(16, 141, 75, 0.10);
    }

    .login-field input::placeholder {
        color: #9aa9a2;
    }

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 5px 0 25px;
        font-size: 14px;
    }

    .remember {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #52685e;
    }

    .remember input {
        width: 17px;
        height: 17px;
        accent-color: #108d4b;
    }

    .forgot {
        color: #108d4b;
        text-decoration: none;
        font-weight: 600;
    }

    .forgot:hover {
        text-decoration: underline;
    }

    .login-submit {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 10px;
        background: #108d4b;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .login-submit:hover {
        background: #087d43;
        transform: translateY(-1px);
    }

    .signup-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 27px 0 18px;
        color: #9aa9a2;
        font-size: 13px;
    }

    .signup-divider::before,
    .signup-divider::after {
        content: "";
        height: 1px;
        background: #dbe3df;
        flex: 1;
    }

    .signup-button {
        display: block;
        width: 100%;
        height: 50px;
        border: 1.5px solid #108d4b;
        border-radius: 10px;
        color: #108d4b;
        background: #ffffff;
        text-decoration: none;
        text-align: center;
        line-height: 47px;
        font-size: 15px;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .signup-button:hover {
        background: #effaf4;
    }

    /* RESPONSIVE */

    @media (max-width: 850px) {
        .login-container {
            grid-template-columns: 1fr;
            max-width: 600px;
        }

        .login-welcome {
            padding: 40px;
            min-height: 330px;
        }

        .food-illustration {
            margin-top: 75px;
            transform: scale(0.75);
        }

        .login-form-area {
            padding: 45px 40px;
        }
    }

    @media (max-width: 500px) {
        .login-page {
            padding: 35px 15px;
        }

        .login-welcome {
            padding: 35px 25px;
        }

        .login-welcome h1 {
            font-size: 30px;
        }

        .login-brand-name {
            font-size: 24px;
        }

        .login-form-area {
            padding: 35px 25px;
        }

        .login-form h2 {
            font-size: 27px;
        }

        .login-options {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>


<div class="login-page">

    <div class="login-container">

        <!-- LEFT SIDE -->

        <div class="login-welcome">

            <div class="login-brand">
                <div class="login-brand-logo">
                    ♻
                </div>

                <div class="login-brand-name">
                    FoodBridge
                </div>
            </div>

            <h1>
                Welcome Back!
            </h1>

            <p>
                Log in to your account and continue making a difference
                by connecting surplus food with people in need.
            </p>

            <div class="food-illustration"></div>

        </div>


        <!-- RIGHT SIDE -->

        <div class="login-form-area">

            <form action="/auth/login" method="POST" class="login-form">

                <h2>
                    Login to Your Account
                </h2>

                <p class="login-subtitle">
                    Enter your email and password to continue.
                </p>


                <!-- EMAIL -->

                <div class="login-field">

                    <label for="email">
                        Email address
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            ✉
                        </span>

                        <input
                            type="email"
                            name="email"
                            id="email"
                            placeholder="Enter your email address"
                            required
                            autofocus
                        >

                    </div>

                </div>


                <!-- PASSWORD -->

                <div class="login-field">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input
                            type="password"
                            name="password"
                            id="password"
                            placeholder="Enter your password"
                            required
                        >

                    </div>

                </div>


                <!-- OPTIONS -->

                <div class="login-options">

                    <label class="remember">
                        <input type="checkbox">
                        Remember me
                    </label>

                    <a href="#" class="forgot">
                        Forgot password?
                    </a>

                </div>


                <!-- LOGIN -->

                <button type="submit" class="login-submit">
                    Login&nbsp; →
                </button>


                <!-- SIGN UP -->

                <div class="signup-divider">
                    Don't have an account?
                </div>

                <a href="/auth/signup" class="signup-button">
                    Sign Up
                </a>

            </form>

        </div>

    </div>

</div>