<main class="donor-page">

    <%- include('../partials/donorSidebar') %>

    <div id="main-wrapper">

        <div class="donor-topbar">
            <div>
                <h1 class="donor-title">My Profile</h1>
                <p class="donor-subtitle">Manage your donor information.</p>
            </div>

            <div class="donor-user">
                <div class="donor-notification">
                    <i class="fas fa-bell"></i>
                </div>

                <div class="donor-avatar">
                    <%= currentUser.firstName.charAt(0) %>
                </div>

                <div class="donor-user-info">
                    <strong><%= currentUser.firstName %> <%= currentUser.lastName %></strong>
                    <span>Donor</span>
                </div>
            </div>
        </div>


        <div class="donor-content">

            <div class="donor-page-heading">
                <div>
                    <h2>Profile Settings</h2>
                    <p>Keep your personal information up to date.</p>
                </div>
            </div>


            <form
                action="/donor/profile?_method=PUT"
                method="POST"
                class="donor-form profile-form">

                <div class="profile-header">

                    <div class="profile-avatar">
                        <%= currentUser.firstName.charAt(0) %>
                    </div>

                    <div>
                        <h3>
                            <%= currentUser.firstName %>
                            <%= currentUser.lastName %>
                        </h3>

                        <p>FoodBridge Donor</p>
                    </div>

                </div>


                <div class="donor-form-section">

                    <div class="form-section-title">
                        <i class="fas fa-user"></i>

                        <div>
                            <h3>Personal Information</h3>
                            <p>Update your basic profile details.</p>
                        </div>
                    </div>


                    <div class="donor-form-row">

                        <div class="donor-form-group">
                            <label for="first-name">First Name</label>

                            <input
                                type="text"
                                name="donor[firstName]"
                                id="first-name"
                                value="<%= currentUser.firstName %>"
                                required>
                        </div>


                        <div class="donor-form-group">
                            <label for="last-name">Last Name</label>

                            <input
                                type="text"
                                name="donor[lastName]"
                                id="last-name"
                                value="<%= currentUser.lastName %>"
                                required>
                        </div>

                    </div>


                    <div class="donor-form-group">

                        <label for="email">Email</label>

                        <input
                            type="email"
                            id="email"
                            value="<%= currentUser.email %>"
                            disabled>

                        <small>Email address cannot be changed.</small>

                    </div>


                    <div class="donor-form-group">

                        <label>Gender</label>

                        <div class="gender-options">

                            <label class="gender-option">
                                <input
                                    type="radio"
                                    name="donor[gender]"
                                    value="male"
                                    <%= currentUser.gender === 'male' ? 'checked' : '' %>>
                                <span>Male</span>
                            </label>

                            <label class="gender-option">
                                <input
                                    type="radio"
                                    name="donor[gender]"
                                    value="female"
                                    <%= currentUser.gender === 'female' ? 'checked' : '' %>>
                                <span>Female</span>
                            </label>

                        </div>

                    </div>

                </div>


                <div class="donor-form-section">

                    <div class="form-section-title">
                        <i class="fas fa-map-marker-alt"></i>

                        <div>
                            <h3>Contact Information</h3>
                            <p>Information used for food collection.</p>
                        </div>
                    </div>


                    <div class="donor-form-group">

                        <label for="address">Address</label>

                        <input
                            type="text"
                            name="donor[address]"
                            id="address"
                            placeholder="Enter your address..."
                            value="<%= currentUser.address %>">

                    </div>


                    <div class="donor-form-group">

                        <label for="phone">Phone Number</label>

                        <input
                            type="number"
                            name="donor[phone]"
                            id="phone"
                            placeholder="Enter your phone number..."
                            value="<%= currentUser.phone %>">

                    </div>

                </div>


                <div class="donor-form-actions">

                    <button type="submit" class="donor-primary-btn">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</main>