<main class="donor-page">

    <%- include('../partials/donorSidebar') %>

    <div id="main-wrapper">

        <div class="donor-topbar">
            <div>
                <h1 class="donor-title">Add Donation</h1>
                <p class="donor-subtitle">Share surplus food with people in need.</p>
            </div>

            <div class="donor-user">
                <div class="donor-notification">
                    <i class="fas fa-bell"></i>
                </div>

                <div class="donor-avatar">
                    <%= currentUser.firstName.charAt(0) %>
                </div>

                <div class="donor-user-info">
                    <strong><%= currentUser.firstName %> <%= currentUser.lastName %></strong>
                    <span>Donor</span>
                </div>
            </div>
        </div>

        <div class="donor-content">

            <div class="donor-page-heading">
                <div>
                    <h2>Donate Food</h2>
                    <p>Provide the details of the food you want to donate.</p>
                </div>
            </div>

            <form action="/donor/donate" method="POST" class="donor-form">

                <div class="donor-form-section">
                    <div class="form-section-title">
                        <i class="fas fa-utensils"></i>
                        <div>
                            <h3>Food Details</h3>
                            <p>Tell us about the food you're donating.</p>
                        </div>
                    </div>

                    <div class="donor-form-group">
                        <label for="food">Food Type</label>
                        <input
                            type="text"
                            name="donation[foodType]"
                            id="food"
                            placeholder="e.g. Veg Biryani, Dal Tadka"
                            required
                            autofocus>
                    </div>

                    <div class="donor-form-row">

                        <div class="donor-form-group">
                            <label for="quantity">Quantity</label>
                            <input
                                type="text"
                                name="donation[quantity]"
                                id="quantity"
                                placeholder="e.g. 10 kg"
                                required>
                        </div>

                        <div class="donor-form-group">
                            <label for="time">Time of Cooking</label>
                            <input
                                type="datetime-local"
                                name="donation[cookingTime]"
                                id="time"
                                required>
                        </div>

                    </div>
                </div>


                <div class="donor-form-section">

                    <div class="form-section-title">
                        <i class="fas fa-map-marker-alt"></i>
                        <div>
                            <h3>Collection Details</h3>
                            <p>Where should our agent collect the food?</p>
                        </div>
                    </div>

                    <div class="donor-form-row">

                        <div class="donor-form-group donor-form-wide">
                            <label for="address">Collection Address</label>
                            <input
                                type="text"
                                name="donation[address]"
                                id="address"
                                placeholder="Enter address..."
                                value="<%= currentUser.address %>"
                                required>
                        </div>

                        <div class="donor-form-group">
                            <label for="phone">Phone Number</label>
                            <input
                                type="number"
                                name="donation[phone]"
                                id="phone"
                                placeholder="Enter phone..."
                                value="<%= currentUser.phone %>"
                                required>
                        </div>

                    </div>

                </div>


                <div class="donor-form-section">

                    <div class="form-section-title">
                        <i class="fas fa-comment-alt"></i>
                        <div>
                            <h3>Additional Message</h3>
                            <p>Anything our team should know?</p>
                        </div>
                    </div>

                    <div class="donor-form-group">
                        <label for="msg">Message <span>(Optional)</span></label>

                        <textarea
                            name="donation[donorToAdminMsg]"
                            id="msg"
                            placeholder="Write any additional information here..."></textarea>
                    </div>

                </div>


                <div class="donor-form-actions">
                    <button type="submit" class="donor-primary-btn">
                        <i class="fas fa-heart"></i>
                        Submit Donation
                    </button>
                </div>

            </form>

        </div>

    </div>

</main>

<script>
    const d = new Date();

    const dateString =
        d.getFullYear() + "-" +
        ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
        ("0" + d.getDate()).slice(-2) + "T" +
        ("0" + d.getHours()).slice(-2) + ":" +
        ("0" + d.getMinutes()).slice(-2);

    document.getElementById("time").value = dateString;
</script>