<main class="donor-page">

    <%- include('../partials/donorSidebar') %>

    <div id="main-wrapper">

        <div class="donor-topbar">

            <div>
                <h1 class="donor-title">Add Donation</h1>
                <p class="donor-subtitle">
                    Share surplus food with people in need.
                </p>
            </div>

            <div class="donor-user">

                <div class="donor-notification">
                    <i class="fas fa-bell"></i>
                </div>

                <div class="donor-avatar">
                    <%= currentUser.firstName.charAt(0) %>
                </div>

                <div class="donor-user-info">
                    <strong>
                        <%= currentUser.firstName %>
                        <%= currentUser.lastName %>
                    </strong>
                    <span>Donor</span>
                </div>

            </div>

        </div>


        <div class="donor-content">

            <div class="donor-page-heading">

                <div>
                    <h2>Donate Food</h2>
                    <p>
                        Provide the details of the food you want to donate.
                    </p>
                </div>

            </div>


            <form
                action="/donor/donate"
                method="POST"
                enctype="multipart/form-data"
                class="donor-form"
            >


                <!-- FOOD DETAILS -->

                <div class="donor-form-section">

                    <div class="form-section-title">

                        <i class="fas fa-utensils"></i>

                        <div>
                            <h3>Food Details</h3>
                            <p>
                                Tell us about the food you're donating.
                            </p>
                        </div>

                    </div>


                    <div class="donor-form-group">

                        <label for="food">
                            Food Name
                        </label>

                        <input
                            type="text"
                            name="donation[foodType]"
                            id="food"
                            placeholder="e.g. Veg Biryani, Dal Tadka"
                            required
                            autofocus
                        >

                    </div>


                    <div class="donor-form-row">

                        <div class="donor-form-group">

                            <label for="quantity">
                                Quantity
                            </label>

                            <input
                                type="text"
                                name="donation[quantity]"
                                id="quantity"
                                placeholder="e.g. 10 kg"
                                required
                            >

                        </div>


                        <div class="donor-form-group " id="cookingTimeGroup">

                            <label for="time">
                                Time of Cooking
                            </label>

                            <input
                                type="datetime-local"
                                name="donation[cookingTime]"
                                id="time"
                            >

                        </div>

                        <div class="donor-form-group" id="packagedDatesGroup" style="display: none;">

                         <div class="donor-form-row">

                             <div class="donor-form-group">

                             <label for="manufactureDate">
                                   Manufacture Date
                             </label>

                             <input
                                   type="date"
                                  name="donation[manufactureDate]"
                                    id="manufactureDate"
                                  >

                                 </div>


                             <div class="donor-form-group">

                                <label for="expiryDate">
                                    Expiry Date
                                </label>

                                <input
                                    type="date"
                                    name="donation[expiryDate]"
                                    id="expiryDate"
                                    >

                            </div>

                        </div>

                        </div>
                             </div>


                    <!-- FOOD CONDITION -->

                    <div class="donor-form-group">

                        <label>
                            Food Condition
                        </label>

                        <div class="food-condition-options">

                            <label class="food-condition-option">

                                <input
                                    type="radio"
                                    name="donation[foodCondition]"
                                    value="cooked"
                                    required
                                >

                                <span>
                                    <i class="fas fa-utensils"></i>
                                    Cooked
                                </span>

                            </label>


                            <label class="food-condition-option">

                                <input
                                    type="radio"
                                    name="donation[foodCondition]"
                                    value="packaged"
                                >

                                <span>
                                    <i class="fas fa-box"></i>
                                    Packaged Food
                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- FOOD IMAGE -->

                    <div class="donor-form-group">

                        <label>
                            Food Photo
                        </label>

                        <div class="food-image-upload">

                            <label
                                for="foodImage"
                                class="food-image-label"
                            >

                                <i class="fas fa-cloud-upload-alt"></i>

                                <strong>
                                    Upload Food Photo
                                </strong>

                                <small>
                                    JPG, JPEG, PNG or WEBP • Max 5MB
                                </small>

                            </label>

                            <input
                                type="file"
                                name="foodImage"
                                id="foodImage"
                                class="food-image-input"
                                accept=".jpg,.jpeg,.png,.webp"
                            >

                            <div
                                id="foodImagePreview"
                                class="food-image-preview"
                            >

                                <img
                                    id="previewImage"
                                    src=""
                                    alt="Food preview"
                                >

                            </div>

                        </div>

                    </div>

                </div>



                <!-- COLLECTION DETAILS -->

                <div class="donor-form-section">

                    <div class="form-section-title">

                        <i class="fas fa-map-marker-alt"></i>

                        <div>
                            <h3>Collection Details</h3>
                            <p>
                                Where should our agent collect the food?
                            </p>
                        </div>

                    </div>


                    <div class="donor-form-row">

                        <div class="donor-form-group donor-form-wide">

                            <label for="address">
                                Collection Address
                            </label>

                            <input
                                type="text"
                                name="donation[address]"
                                id="address"
                                placeholder="Enter address..."
                                value="<%= currentUser.address %>"
                                required
                            >

                        </div>


                        <div class="donor-form-group">

                            <label for="phone">
                                Phone Number
                            </label>

                            <input
                                type="number"
                                name="donation[phone]"
                                id="phone"
                                placeholder="Enter phone..."
                                value="<%= currentUser.phone %>"
                                required
                            >

                        </div>

                    </div>

                </div>



                <!-- ADDITIONAL MESSAGE -->

                <div class="donor-form-section">

                    <div class="form-section-title">

                        <i class="fas fa-comment-alt"></i>

                        <div>
                            <h3>Additional Message</h3>
                            <p>
                                Anything our team should know?
                            </p>
                        </div>

                    </div>


                    <div class="donor-form-group">

                        <label for="msg">
                            Message <span>(Optional)</span>
                        </label>

                        <textarea
                            name="donation[donorToAdminMsg]"
                            id="msg"
                            placeholder="Write any additional information here..."
                        ></textarea>

                    </div>

                </div>



                <!-- SUBMIT -->

                <div class="donor-form-actions">

                    <button
                        type="submit"
                        class="donor-primary-btn"
                    >

                        <i class="fas fa-heart"></i>

                        Submit Donation

                    </button>

                </div>

            </form>

        </div>

    </div>

</main>


<script>

    // Food condition fields

const foodConditionInputs =
    document.querySelectorAll(
        'input[name="donation[foodCondition]"]'
    );

const cookingTimeGroup =
    document.getElementById("cookingTimeGroup");

const cookingTimeInput =
    document.getElementById("time");

const packagedDatesGroup =
    document.getElementById("packagedDatesGroup");

const manufactureDate =
    document.getElementById("manufactureDate");

const expiryDate =
    document.getElementById("expiryDate");


foodConditionInputs.forEach(input => {

    input.addEventListener("change", function () {

        if (this.value === "cooked") {

            cookingTimeGroup.style.display = "block";
            packagedDatesGroup.style.display = "none";

            cookingTimeInput.required = true;

            manufactureDate.required = false;
            expiryDate.required = false;

            const d = new Date();

            const dateString =
                d.getFullYear() + "-" +
                ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
                ("0" + d.getDate()).slice(-2) + "T" +
                ("0" + d.getHours()).slice(-2) + ":" +
                ("0" + d.getMinutes()).slice(-2);

            cookingTimeInput.value = dateString;

        }

        else if (this.value === "packaged") {

            cookingTimeGroup.style.display = "none";
            packagedDatesGroup.style.display = "block";

            cookingTimeInput.required = false;
            cookingTimeInput.value = "";

            manufactureDate.required = true;
            expiryDate.required = true;

        }

    });

});


    // Food image preview

    const foodImageInput =
        document.getElementById("foodImage");

    const foodImagePreview =
        document.getElementById("foodImagePreview");

    const previewImage =
        document.getElementById("previewImage");


    foodImageInput.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) {

            foodImagePreview.style.display = "none";
            previewImage.src = "";

            return;
        }


        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];


        if (!allowedTypes.includes(file.type)) {

            alert(
                "Only JPG, JPEG, PNG and WEBP images are allowed."
            );

            this.value = "";
            foodImagePreview.style.display = "none";
            previewImage.src = "";

            return;
        }


        if (file.size > 5 * 1024 * 1024) {

            alert("Image size must be less than 5MB.");

            this.value = "";
            foodImagePreview.style.display = "none";
            previewImage.src = "";

            return;
        }


        const reader = new FileReader();

        reader.onload = function (e) {

            previewImage.src = e.target.result;

            foodImagePreview.style.display = "block";

        };


        reader.readAsDataURL(file);

    });

</script>