<main class="donor-dashboard-page">

    <%- include('../partials/donorSidebar') %>

    <div id="main-wrapper">

        <div class="donor-topbar">
            <div class="donor-title">Donor Dashboard</div>

            <div class="donor-user">
                <div class="donor-notification">
                    <i class="fas fa-bell"></i>
                </div>

                <div class="donor-avatar">
                    <%= currentUser.firstName.charAt(0) %>
                </div>

                <div class="donor-user-info">
                    <strong>
                        <%= currentUser.firstName %> <%= currentUser.lastName %>
                    </strong>
                    <span>Donor</span>
                </div>
            </div>
        </div>


        <div class="donor-content">

            <div class="dashboard-welcome">
                <h1>Welcome back, <%= currentUser.firstName %>! 👋</h1>
                <p>Thank you for being a part of FoodBridge.</p>
            </div>


            <div class="dashboard-stats">

                <div class="dashboard-stat">
                    <div class="dashboard-stat-icon blue">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <div>
                        <span>Total Donations</span>
                        <strong>
                            <%= numPendingDonations + numAcceptedDonations + numAssignedDonations + numCollectedDonations %>
                        </strong>
                        <small>All your donations</small>
                    </div>
                </div>

                <div class="dashboard-stat">
                    <div class="dashboard-stat-icon green">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <span>Successful Donations</span>
                        <strong><%= numCollectedDonations %></strong>
                        <small>Successfully collected</small>
                    </div>
                </div>

                <div class="dashboard-stat">
                    <div class="dashboard-stat-icon yellow">
                        <i class="fas fa-star"></i>
                    </div>
                    <div>
                        <span>Trust Score</span>
                        <strong>92 <em>/100</em></strong>
                        <small>Excellent</small>
                    </div>
                </div>

                <div class="dashboard-stat">
                    <div class="dashboard-stat-icon purple">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <span>People Helped</span>
                        <strong>450+</strong>
                        <small>Meals reaching people</small>
                    </div>
                </div>

            </div>


            <div class="dashboard-grid">

                <div class="dashboard-card">

                    <div class="dashboard-card-header">
                        <div>
                            <h2>My Recent Donations</h2>
                            <p>Your latest food donations</p>
                        </div>

                        <a href="/donor/donations/pending"
                           class="dashboard-view-btn">
                            View All
                        </a>
                    </div>


                    <div class="recent-list">

                        <div class="recent-row">
                            <div class="recent-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>

                            <div class="recent-info">
                                <strong>Completed Donations</strong>
                                <span>Successfully collected food</span>
                            </div>

                            <span class="badge collected">Collected</span>
                            <b><%= numCollectedDonations %></b>
                        </div>


                        <div class="recent-row">
                            <div class="recent-icon">
                                <i class="fas fa-clock"></i>
                            </div>

                            <div class="recent-info">
                                <strong>Pending Donations</strong>
                                <span>Waiting for admin approval</span>
                            </div>

                            <span class="badge pending">Pending</span>
                            <b><%= numPendingDonations %></b>
                        </div>


                        <div class="recent-row">
                            <div class="recent-icon">
                                <i class="fas fa-check"></i>
                            </div>

                            <div class="recent-info">
                                <strong>Accepted Donations</strong>
                                <span>Waiting for agent assignment</span>
                            </div>

                            <span class="badge accepted">Accepted</span>
                            <b><%= numAcceptedDonations %></b>
                        </div>


                        <div class="recent-row">
                            <div class="recent-icon">
                                <i class="fas fa-truck"></i>
                            </div>

                            <div class="recent-info">
                                <strong>Assigned Donations</strong>
                                <span>Agent will collect your donation</span>
                            </div>

                            <span class="badge assigned">Assigned</span>
                            <b><%= numAssignedDonations %></b>
                        </div>

                    </div>

                </div>


                <div class="dashboard-card trust-card">

                    <div class="dashboard-card-header">
                        <h2>Trust Score Progress</h2>
                    </div>

                    <div class="trust-body">

                        <div class="trust-circle">
                            <strong>92</strong>
                            <span>/100</span>
                        </div>

                        <h3>Excellent!</h3>

                        <p>
                            Keep it up, you're making<br>
                            a big difference.
                        </p>

                        <a href="/donor/profile" class="trust-btn">
                            View Details
                        </a>

                    </div>

                </div>

            </div>


            <div class="dashboard-card why-card">

                <div class="dashboard-card-header">
                    <div>
                        <h2>Why Your Donations Matter?</h2>
                        <p>Together we can make a difference</p>
                    </div>
                </div>

                <div class="why-grid">

                    <div class="why-item">
                        <div class="why-icon">
                            <i class="fas fa-recycle"></i>
                        </div>
                        <div>
                            <h3>Reduce Food Waste</h3>
                            <p>Prevent nutritious food from going to landfill.</p>
                        </div>
                    </div>

                    <div class="why-item">
                        <div class="why-icon">
                            <i class="fas fa-hands-helping"></i>
                        </div>
                        <div>
                            <h3>Feed People in Need</h3>
                            <p>Help NGOs provide meals to those who need it most.</p>
                        </div>
                    </div>

                    <div class="why-item">
                        <div class="why-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <h3>Build a Better Community</h3>
                            <p>Together, we can create a hunger-free society.</p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</main>