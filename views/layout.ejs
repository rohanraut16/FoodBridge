<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FoodBridge</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #ffffff;
            color: #123b2a;
        }

        /* =========================
           NAVBAR
        ========================= */

        .fb-navbar {
            width: 100%;
            height: 88px;
            background: #ffffff;
            border-bottom: 1px solid #e5e5e5;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 7%;
            position: relative;
            z-index: 1000;
        }

        /* LOGO */

        .fb-logo {
            display: flex;
            align-items: center;
            gap: 12px;

            text-decoration: none;
            color: #087f45;

            font-size: 30px;
            font-weight: 700;
        }

        .fb-logo-icon {
            width: 48px;
            height: 48px;

            background: #138b4d;
            border-radius: 14px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;
            font-size: 25px;
        }

        /* NAV LINKS */

        .fb-nav-links {
            display: flex;
            align-items: center;
            gap: 42px;
        }

        .fb-nav-links a {
            text-decoration: none;
            color: #16231d;

            font-size: 17px;
            font-weight: 600;

            transition: 0.2s ease;
        }

        .fb-nav-links a:hover {
            color: #138b4d;
        }

        /* BUTTONS */

        .fb-nav-buttons {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .fb-login {
            text-decoration: none;

            border: 1.5px solid #138b4d;
            color: #138b4d;

            padding: 13px 25px;
            border-radius: 8px;

            font-size: 16px;
            font-weight: 600;

            transition: 0.2s ease;
        }

        .fb-login:hover {
            background: #f0faf5;
        }

        .fb-signup {
            text-decoration: none;

            background: #138b4d;
            color: white;

            padding: 14px 27px;
            border-radius: 8px;

            font-size: 16px;
            font-weight: 600;

            transition: 0.2s ease;
        }

        .fb-signup:hover {
            background: #0d713d;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 900px) {

            .fb-navbar {
                height: auto;
                min-height: 80px;
                padding: 18px 5%;

                flex-wrap: wrap;
                gap: 20px;
            }

            .fb-logo {
                font-size: 25px;
            }

            .fb-nav-links {
                order: 3;
                width: 100%;

                justify-content: center;
                gap: 25px;

                flex-wrap: wrap;
            }

            .fb-nav-buttons {
                gap: 8px;
            }

            .fb-login,
            .fb-signup {
                padding: 10px 16px;
            }
        }

        @media (max-width: 600px) {

            .fb-navbar {
                flex-direction: column;
                align-items: center;
            }

            .fb-nav-links {
                gap: 18px;
            }

            .fb-nav-links a {
                font-size: 14px;
            }

            .fb-nav-buttons {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         FOODBRIDGE NAVBAR
    ========================= -->

    <header class="fb-navbar">

        <!-- LOGO -->
        <a href="/" class="fb-logo">

            <span class="fb-logo-icon">♻</span>

            <span>FoodBridge</span>

        </a>


        <!-- NAVIGATION -->
        <nav class="fb-nav-links">

            <a href="/">Home</a>

            <a href="/aboutUs">About</a>

            <a href="/mission">How It Works</a>

            <a href="/contactUs">Contact</a>

        </nav>


        <!-- AUTH BUTTONS -->
        <div class="fb-nav-buttons">

            <a href="/login" class="fb-login">
                Login
            </a>

            <a href="/signup" class="fb-signup">
                Sign Up
            </a>

        </div>

    </header>


    <!-- =========================
         PAGE CONTENT
    ========================= -->

    <main>
        <%- body %>
    </main>


</body>
</html>