<main>
    <%- include('../partials/adminSidebar') %>

    <div id="main-wrapper">

        <!-- Top Bar -->
       <div class="admin-page-title">

    		<h2>Donation Management</h2>

   			 <p>
       			 View and manage all approved, rejected and completed donations.
   			 </p>

		</div>

        <!-- Main Content -->
        <div class="p-4">

            <!-- Page Heading -->
            <div class="mb-4">
                <h3 class="fw-bold">
                    Donation Management
                </h3>

                <p class="text-muted mb-0">
                    View and manage all approved, rejected and completed donations.
                </p>
            </div>

            <% if (!previousDonations || previousDonations.length === 0) { %>

                <!-- Empty State -->
                <div class="bg-white rounded shadow-sm p-5 text-center">

                    <div
                        class="d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="
                            width:70px;
                            height:70px;
                            border-radius:20px;
                            background:#e8f7ef;
                            color:#087f5b;
                            font-size:28px;
                        "
                    >
                        <i class="fas fa-box-open"></i>
                    </div>

                    <h5 class="fw-bold">
                        No Donations Found
                    </h5>

                    <p class="text-muted mb-0">
                        Approved, rejected and completed donations will appear here.
                    </p>

                </div>

            <% } else { %>

                <!-- Donation Table -->
                <div class="bg-white rounded shadow-sm table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Donor</th>
                                <th>Food</th>
                                <th>Quantity</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% previousDonations.forEach((donation, index) => { %>

                                <tr>

                                    <!-- Number -->
                                    <td>
                                        <strong>
                                            <%= index + 1 %>
                                        </strong>
                                    </td>

                                    <!-- Donor -->
                                    <td>
                                        <% if (donation.donor) { %>

                                            <strong>
                                                <%= donation.donor.firstName %>
                                                <%= donation.donor.lastName %>
                                            </strong>

                                            <br>

                                            <small class="text-muted">
                                                <%= donation.donor.email %>
                                            </small>

                                        <% } else { %>

                                            <span class="text-muted">
                                                Unknown Donor
                                            </span>

                                        <% } %>
                                    </td>

                                    <!-- Food -->
                                    <td>
                                        <strong>
                                            <%= donation.foodType %>
                                        </strong>
                                    </td>

                                    <!-- Quantity -->
                                    <td>
                                        <%= donation.quantity %>
                                    </td>

                                    <!-- Food Condition -->
                                    <td>

                                        <% if (donation.foodCondition === "cooked") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#fff4d6;
                                                    color:#9a6700;
                                                    padding:7px 10px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-utensils me-1"></i>
                                                Cooked
                                            </span>

                                        <% } else if (donation.foodCondition === "packaged") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#e8f1ff;
                                                    color:#2864b7;
                                                    padding:7px 10px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-box me-1"></i>
                                                Packaged
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                                <%= donation.foodCondition %>
                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- Status -->
                                    <td>

                                        <% if (donation.status === "accepted") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#e8f7ef;
                                                    color:#087f5b;
                                                    padding:7px 11px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-check-circle me-1"></i>
                                                Accepted
                                            </span>

                                        <% } else if (donation.status === "assigned") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#fff4d6;
                                                    color:#9a6700;
                                                    padding:7px 11px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-truck me-1"></i>
                                                Assigned
                                            </span>

                                        <% } else if (donation.status === "collected") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#e7f5ff;
                                                    color:#1769aa;
                                                    padding:7px 11px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-check-double me-1"></i>
                                                Collected
                                            </span>

                                        <% } else if (donation.status === "rejected") { %>

                                            <span
                                                class="badge"
                                                style="
                                                    background:#ffe9e9;
                                                    color:#c92a2a;
                                                    padding:7px 11px;
                                                    border-radius:20px;
                                                "
                                            >
                                                <i class="fas fa-times-circle me-1"></i>
                                                Rejected
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                                <%= donation.status %>
                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- Action -->
                                    <td>

                                        <a
                                            href="/admin/donation/view/<%= donation._id %>"
                                            class="btn btn-sm"
                                            style="
                                                background:#e8f7ef;
                                                color:#087f5b;
                                                border:none;
                                                border-radius:8px;
                                                font-weight:600;
                                                padding:7px 14px;
                                            "
                                        >
                                            <i class="fas fa-eye me-1"></i>
                                            View
                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>
</main>