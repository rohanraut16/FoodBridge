<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Physical Food Verification</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f5f7fa;
        }

        .verification-container {
            max-width: 1000px;
            margin: 40px auto;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .card-header {
            background: #198754;
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px;
        }

        .food-image {
            width: 100%;
            max-height: 300px;
            object-fit: cover;
            border-radius: 10px;
        }

        .score-box {
            text-align: center;
            padding: 20px;
            border-radius: 12px;
            background: #f8f9fa;
        }

        .score {
            font-size: 45px;
            font-weight: bold;
            color: #198754;
        }

        .check-item {
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            margin-bottom: 12px;
            background: white;
        }

        .check-item:hover {
            background: #f8f9fa;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .action-buttons button {
            flex: 1;
        }

    </style>
</head>

<body>

<div class="container verification-container">

    <!-- PAGE HEADER -->
    <div class="card mb-4">

        <div class="card-header">

            <h3 class="mb-1">
                Physical Food Verification
            </h3>

            <p class="mb-0">
                Verify the food condition before accepting the donation.
            </p>

        </div>


        <div class="card-body">

            <!-- FOOD INFORMATION -->

            <div class="row">

                <div class="col-md-5">

                    <% if (donation.foodImage) { %>

                        <img
                            src="<%= donation.foodImage %>"
                            class="food-image"
                            alt="Food Image"
                        >

                    <% } else { %>

                        <div
                            class="d-flex align-items-center justify-content-center bg-light"
                            style="height:250px;border-radius:10px;"
                        >
                            <span class="text-muted">
                                No food image available
                            </span>
                        </div>

                    <% } %>

                </div>


                <div class="col-md-7">

                    <h4 class="mb-3">
                        <%= donation.foodType %>
                    </h4>

                    <p>
                        <strong>Quantity:</strong>
                        <%= donation.quantity %>
                    </p>

                    <p>
                        <strong>Food Type:</strong>

                        <% if (donation.foodCondition === "cooked") { %>
                            Cooked
                        <% } else { %>
                            Packaged
                        <% } %>

                    </p>

                    <p>
                        <strong>Donor:</strong>

                        <% if (donation.donor) { %>
                            <%= donation.donor.firstName || "" %>
                            <%= donation.donor.lastName || "" %>
                        <% } else { %>
                            Unknown
                        <% } %>

                    </p>

                    <p>
                        <strong>Pickup Address:</strong>
                        <%= donation.address %>
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        <%= donation.phone %>
                    </p>

                </div>

            </div>

        </div>

    </div>



    <!-- SYSTEM QUALITY INFORMATION -->

    <div class="card mb-4">

        <div class="card-header">

            <h4 class="mb-0">
                System Food Quality Information
            </h4>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- FRESHNESS SCORE -->

                <div class="col-md-4">

                    <div class="score-box">

                        <div class="text-muted">
                            Freshness Score
                        </div>

                        <div class="score">
                            <%= freshnessScore %>/100
                        </div>

                    </div>

                </div>


                <!-- QUALITY STATUS -->

                <div class="col-md-4">

                    <div class="score-box">

                        <div class="text-muted">
                            Food Safety Status
                        </div>

                        <% if (qualityStatus === "safe") { %>

                            <span class="badge bg-success fs-5 mt-3">
                                Safe to Donate
                            </span>

                        <% } else if (qualityStatus === "warning") { %>

                            <span class="badge bg-warning text-dark fs-5 mt-3">
                                Warning
                            </span>

                        <% } else { %>

                            <span class="badge bg-danger fs-5 mt-3">
                                Unsafe to Donate
                            </span>

                        <% } %>

                    </div>

                </div>


                <!-- SHELF LIFE -->

                <div class="col-md-4">

                    <div class="score-box">

                        <div class="text-muted">
                            Estimated Shelf Life
                        </div>

                        <h4 class="mt-3">
                            <%= shelfLife %>
                        </h4>

                    </div>

                </div>

            </div>


            <!-- DATE INFORMATION -->

            <hr class="my-4">


            <div class="row">

                <div class="col-md-4">

                    <strong>Cooking Time</strong>

                    <p class="text-muted">

                        <% if (donation.cookingTime) { %>

                            <%= new Date(donation.cookingTime).toLocaleString() %>

                        <% } else { %>

                            Not Available

                        <% } %>

                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Manufacture Date</strong>

                    <p class="text-muted">

                        <% if (donation.manufactureDate) { %>

                            <%= new Date(donation.manufactureDate).toLocaleDateString() %>

                        <% } else { %>

                            Not Available

                        <% } %>

                    </p>

                </div>


                <div class="col-md-4">

                    <strong>Expiry Date</strong>

                    <p class="text-muted">

                        <% if (donation.expiryDate) { %>

                            <%= new Date(donation.expiryDate).toLocaleDateString() %>

                        <% } else { %>

                            Not Available

                        <% } %>

                    </p>

                </div>

            </div>

        </div>

    </div>



    <!-- PHYSICAL VERIFICATION -->

    <div class="card">

        <div class="card-header">

            <h4 class="mb-0">
                NGO Physical Verification
            </h4>

        </div>


        <div class="card-body">

            <p class="text-muted">
                Please physically inspect the food and confirm each condition
                before accepting the donation.
            </p>


            <form
                action="/agent/donation/verify/<%= donation._id %>"
                method="POST"
            >


                <!-- SMELL -->

                <div class="check-item">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="smellCheck"
                            id="smellCheck"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="smellCheck"
                        >

                            <strong>Smell Check</strong>

                            <br>

                            <small class="text-muted">
                                Food has a normal smell and no bad or
                                unpleasant odour.
                            </small>

                        </label>

                    </div>

                </div>


                <!-- APPEARANCE -->

                <div class="check-item">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="appearanceCheck"
                            id="appearanceCheck"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="appearanceCheck"
                        >

                            <strong>Appearance Check</strong>

                            <br>

                            <small class="text-muted">
                                Food looks normal and shows no visible
                                spoilage or unusual appearance.
                            </small>

                        </label>

                    </div>

                </div>


                <!-- PACKAGING -->

                <div class="check-item">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="packagingCheck"
                            id="packagingCheck"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="packagingCheck"
                        >

                            <strong>Packaging Condition</strong>

                            <br>

                            <small class="text-muted">
                                Packaging is properly sealed and does not
                                appear damaged or contaminated.
                            </small>

                        </label>

                    </div>

                </div>


                <!-- EXPIRY -->

                <div class="check-item">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="expiryCheck"
                            id="expiryCheck"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="expiryCheck"
                        >

                            <strong>Expiry Check</strong>

                            <br>

                            <small class="text-muted">
                                Food is within its expiry date.
                            </small>

                        </label>

                    </div>

                </div>


                <!-- STORAGE -->

                <div class="check-item">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="storageCheck"
                            id="storageCheck"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="storageCheck"
                        >

                            <strong>Storage Condition</strong>

                            <br>

                            <small class="text-muted">
                                Food appears to have been stored under
                                suitable conditions.
                            </small>

                        </label>

                    </div>

                </div>



                <!-- ACTION BUTTONS -->

                <div class="action-buttons">

                    <button
                        type="submit"
                        class="btn btn-success btn-lg"
                    >

                        ✓ Verify & Accept Donation

                    </button>


                    <a
                        href="/agent/donations/available"
                        class="btn btn-outline-secondary btn-lg"
                    >

                        Cancel

                    </a>

                </div>

            </form>


            <!-- REJECT FORM -->

            <form
                action="/agent/donation/reject/<%= donation._id %>"
                method="POST"
                class="mt-3"
            >

                <button
                    type="submit"
                    class="btn btn-danger w-100"
                    onclick="return confirm('Are you sure you want to reject this donation?')"
                >

                    ✕ Reject Donation

                </button>

            </form>

        </div>

    </div>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>