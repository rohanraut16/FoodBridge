
<main class="ngo-page">

    <%- include('../partials/agentSidebar') %>

    <div id="main-wrapper">
        <style>
            * {
                box-sizing: border-box;
            }

            #main-wrapper {
                width: calc(100% - 260px);
                margin-left: 260px;
                min-height: 100vh;
                background: #f2f7f4;
                color: #183b2e;
                font-family: "Segoe UI", Arial, sans-serif;
                overflow-x: hidden;
            }

            .ngo-dashboard {
                width: 100%;
                max-width: 1600px;
                margin: auto;
                padding: 30px;
            }

            .welcome-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 30px;
                margin-bottom: 28px;
                background: linear-gradient(120deg, #fff, #e6f5ec);
                border: 1px solid #dcebe2;
                border-radius: 18px;
            }

            .eyebrow {
                color: #27815b;
                font-size: 12px;
                font-weight: 800;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            .welcome-bar h1 {
                margin: 8px 0;
                color: #174c38;
                font-size: 32px;
            }

            .welcome-bar p {
                color: #718078;
                line-height: 1.6;
            }

            .welcome-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 70px;
                height: 70px;
                background: #d6f0e0;
                border-radius: 18px;
                font-size: 32px;
            }

            .stats-row {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 18px;
                margin-bottom: 30px;
            }

            .stat-card {
                min-width: 0;
                padding: 22px;
                background: white;
                border: 1px solid #e2ebe5;
                border-radius: 16px;
                box-shadow: 0 5px 18px rgba(24, 59, 46, .04);
            }

            .stat-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
            }

            .stat-title {
                color: #65766d;
                font-size: 13px;
                font-weight: 700;
                line-height: 1.5;
            }

            .stat-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 40px;
                height: 40px;
                background: #e8f6ed;
                border-radius: 12px;
                font-size: 20px;
            }

            .stat-number {
                margin-top: 12px;
                color: #174c38;
                font-size: 34px;
                font-weight: 800;
            }

            .stat-caption {
                margin-top: 6px;
                color: #84948b;
                font-size: 12px;
                line-height: 1.5;
            }

            .dashboard-section {
                margin-bottom: 26px;
                overflow: hidden;
                background: #fff;
                border: 1px solid #e1ebe5;
                border-radius: 16px;
                box-shadow: 0 5px 20px rgba(24, 59, 46, .04);
            }

            .section-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 22px 26px;
                border-bottom: 1px solid #edf2ee;
            }

            .section-heading {
                display: flex;
                align-items: center;
                gap: 13px;
                min-width: 0;
            }

            .section-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 42px;
                height: 42px;
                background: #eaf6ee;
                border-radius: 12px;
                font-size: 20px;
            }

            .section-header h2 {
                margin: 0;
                color: #174c38;
                font-size: 17px;
            }

            .section-subtitle {
                margin: 5px 0 0;
                color: #84948b;
                font-size: 12px;
            }

            .view-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 11px 15px;
                background: #237b56;
                color: #fff;
                border-radius: 9px;
                text-decoration: none;
                text-align: center;
                font-size: 12px;
                font-weight: 700;
                white-space: nowrap;
            }

            .view-btn:hover {
                background: #185d40;
                color: #fff;
                text-decoration: none;
            }

            .section-body {
                padding: 8px 26px;
            }

            .donation-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 22px 0;
                border-bottom: 1px solid #edf2ef;
            }

            .donation-item:last-child {
                border-bottom: none;
            }

            .donation-info {
                min-width: 0;
                overflow-wrap: anywhere;
            }

            .donation-info h3 {
                margin: 0 0 9px;
                color: #174c38;
                font-size: 16px;
            }

            .donation-info p {
                margin: 5px 0;
                color: #74847b;
                font-size: 13px;
                line-height: 1.6;
            }

            .donation-info strong {
                color: #4d6558;
            }

            .empty-message {
                margin: 0;
                padding: 42px 15px;
                background: #fbfdfc;
                border-radius: 10px;
                color: #84948b;
                text-align: center;
                font-size: 14px;
                line-height: 1.8;
            }

            .empty-icon {
                display: block;
                margin-bottom: 10px;
                font-size: 30px;
            }

            .dashboard-footer {
                padding: 10px 0 20px;
                color: #84948b;
                text-align: center;
                font-size: 12px;
            }

            @media (max-width: 1250px) {
                .ngo-dashboard {
                    padding: 24px;
                }

                .stats-row {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @media (max-width: 768px) {
                #main-wrapper {
                    width: 100%;
                    margin-left: 0;
                }

                .ngo-dashboard {
                    padding: 18px 14px;
                }

                .welcome-bar {
                    padding: 22px;
                }

                .welcome-bar h1 {
                    font-size: 26px;
                }

                .section-header {
                    padding: 18px;
                }

                .section-body {
                    padding: 6px 18px;
                }
            }

            @media (max-width: 480px) {
                .ngo-dashboard {
                    padding: 12px;
                }

                .welcome-bar {
                    padding: 16px;
                }

                .welcome-bar h1 {
                    font-size: 22px;
                }

                .welcome-icon {
                    width: 44px;
                    height: 44px;
                    font-size: 22px;
                }

                .stats-row {
                    gap: 10px;
                }

                .stat-card {
                    padding: 13px;
                }

                .stat-title {
                    font-size: 11px;
                }

                .stat-icon {
                    width: 30px;
                    height: 30px;
                    font-size: 15px;
                }

                .stat-number {
                    font-size: 27px;
                }

                .section-header {
                    gap: 8px;
                    padding: 14px 11px;
                }

                .section-heading {
                    gap: 8px;
                }

                .section-icon {
                    width: 32px;
                    height: 32px;
                    font-size: 16px;
                }

                .section-header h2 {
                    font-size: 13px;
                }

                .section-subtitle {
                    font-size: 10px;
                }

                .view-btn {
                    padding: 9px;
                    font-size: 10px;
                }

                .section-body {
                    padding: 5px 13px;
                }

                .donation-item {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 13px;
                }
            }
        </style>

        <div class="ngo-dashboard">

            <section class="welcome-bar">
                <div>
                    <p class="eyebrow">FoodBridge · NGO Portal</p>
                    <h1>NGO Dashboard</h1>
                    <p>Manage food donations, pickups and completed collections.</p>
                </div>
                <div class="welcome-icon">
                    <i class="fas fa-hand-holding-heart"></i>
                </div>
            </section>

            <section class="stats-row">
                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-title">Available Donations</div>
                        <div class="stat-icon">🍱</div>
                    </div>
                    <div class="stat-number"><%= typeof numAvailableDonations !== 'undefined' ? numAvailableDonations : 0 %></div>
                    <div class="stat-caption">Donations ready for collection</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-title">Accepted Donations</div>
                        <div class="stat-icon">🤝</div>
                    </div>
                    <div class="stat-number"><%= typeof numAcceptedDonations !== 'undefined' ? numAcceptedDonations : 0 %></div>
                    <div class="stat-caption">Donations accepted by your NGO</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-title">Pending Pickups</div>
                        <div class="stat-icon">🚚</div>
                    </div>
                    <div class="stat-number"><%= typeof numPendingPickups !== 'undefined' ? numPendingPickups : 0 %></div>
                    <div class="stat-caption">Collections awaiting completion</div>
                </div>

                <div class="stat-card">
                    <div class="stat-top">
                        <div class="stat-title">Completed Pickups</div>
                        <div class="stat-icon">✅</div>
                    </div>
                    <div class="stat-number"><%= typeof numCompletedPickups !== 'undefined' ? numCompletedPickups : 0 %></div>
                    <div class="stat-caption">Successfully collected donations</div>
                </div>
            </section>

            <section class="dashboard-section">
                <div class="section-header">
                    <div class="section-heading">
                        <div class="section-icon">🍲</div>
                        <div>
                            <h2>Recent Available Donations</h2>
                            <p class="section-subtitle">Discover food available for collection</p>
                        </div>
                    </div>
                    <a href="/agent/donations/available" class="view-btn">View All →</a>
                </div>

                <div class="section-body">
                    <%
                        const recentAvailable = typeof recentAvailableDonations !== 'undefined'
                            ? recentAvailableDonations
                            : (typeof availableDonations !== 'undefined' ? availableDonations : []);
                    %>

                    <% if (recentAvailable && recentAvailable.length > 0) { %>
                        <% recentAvailable.forEach(function(donation) { %>
                            <div class="donation-item">
                                <div class="donation-info">
                                    <h3><%= donation.foodType || 'Food Donation' %></h3>
                                    <p><strong>Quantity:</strong> <%= donation.quantity || '-' %></p>
                                    <p><strong>Address:</strong> <%= donation.address || 'Not provided' %></p>
                                </div>
                                <a href="/agent/donation/view/<%= donation._id %>" class="view-btn">View Details →</a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="empty-message">
                            <span class="empty-icon">🥗</span>
                            <strong>No Available Donations</strong><br>
                            There are currently no approved donations available.<br>
                            Please check again later for new food donations.
                        </p>
                    <% } %>
                </div>
            </section>

            <section class="dashboard-section">
                <div class="section-header">
                    <div class="section-heading">
                        <div class="section-icon">📦</div>
                        <div>
                            <h2>Recent Completed Pickups</h2>
                            <p class="section-subtitle">Review your completed collections</p>
                        </div>
                    </div>
                    <a href="/agent/collections/previous" class="view-btn">View All →</a>
                </div>

                <div class="section-body">
                    <%
                        const recentCompleted = typeof recentCompletedPickups !== 'undefined'
                            ? recentCompletedPickups
                            : (typeof completedPickups !== 'undefined' ? completedPickups : []);
                    %>

                    <% if (recentCompleted && recentCompleted.length > 0) { %>
                        <% recentCompleted.forEach(function(donation) { %>
                            <div class="donation-item">
                                <div class="donation-info">
                                    <h3><%= donation.foodType || 'Food Donation' %></h3>
                                    <p><strong>Quantity:</strong> <%= donation.quantity || '-' %></p>
                                    <p>
                                        <strong>Collected:</strong>
                                        <%= donation.collectionTime
                                            ? new Date(donation.collectionTime).toLocaleDateString("en-IN")
                                            : '-' %>
                                    </p>
                                </div>
                                <a href="/agent/collection/view/<%= donation._id %>" class="view-btn">View Details →</a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="empty-message">
                            <span class="empty-icon">📋</span>
                            <strong>No Completed Pickups Yet</strong><br>
                            Your completed collections will appear here.
                        </p>
                    <% } %>
                </div>
            </section>

            <footer class="dashboard-footer">
                FoodBridge NGO Portal · Connecting surplus food with those in need
            </footer>

        </div>
    </div>
</main>
