      </h2>

      <p class="fb-visual-text">
        Turning surplus into meaningful support.
      </p>

    </div>

  </section>


  <!-- STATISTICS -->
  <section class="fb-stats">

    <div class="fb-stat">
      <span class="fb-stat-number">1200+</span>
      <span class="fb-stat-label">Food Donations</span>
    </div>

    <div class="fb-stat">
      <span class="fb-stat-number">350+</span>
