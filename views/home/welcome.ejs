<style>
  * {
    box-sizing: border-box;
  }

  .fb-home {
    font-family: Arial, Helvetica, sans-serif;
    color: #123d2b;
    background: #f3fcf7;
    min-height: calc(100vh - 105px);
  }

  .fb-hero {
    max-width: 1500px;
    margin: 0 auto;
    padding: 90px 70px 70px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .fb-badge {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 30px;
    background: #dcf5e8;
    color: #087b42;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 30px;
  }

  .fb-title {
    margin: 0;
    font-size: 76px;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -2px;
  }

  .fb-title span {
    color: #149451;
    font-weight: 600;
  }

  .fb-description {
    max-width: 700px;
    margin: 30px 0;
    font-size: 20px;
    line-height: 1.65;
    color: #496b5c;
  }

  .fb-buttons {
    display: flex;
    gap: 18px;
    margin-top: 30px;
  }

  .fb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 175px;
    padding: 17px 28px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .fb-btn-primary {
    background: #108b4d;
    color: white;
    border: 2px solid #108b4d;
  }

  .fb-btn-primary:hover {
    background: #08783f;
    border-color: #08783f;
  }

  .fb-btn-outline {
    background: white;
    color: #108b4d;
    border: 2px solid #108b4d;
  }

  .fb-btn-outline:hover {
    background: #eaf8f0;
  }

  /* Right hero card */

  .fb-visual {
    height: 520px;
    border-radius: 30px;
    background: #d1f0de;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .fb-circle-top {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #e4f7ec;
    right: -90px;
    top: -100px;
  }

  .fb-circle-bottom {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: #e3f7ec;
    left: -100px;
    bottom: -100px;
  }

  .fb-food-icons {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 35px;
    margin-bottom: 40px;
  }

  .fb-food-box {
    width: 125px;
    height: 105px;
    border-radius: 12px;
    background: #65518d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 58px;
    transform: rotate(2deg);
    box-shadow: 0 12px 20px rgba(0,0,0,0.08);
  }

  .fb-food-bowl {
    width: 125px;
    height: 85px;
    border-radius: 0 0 60px 60px;
    background: #aaa5c2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 55px;
    box-shadow: 0 12px 20px rgba(0,0,0,0.08);
  }

  .fb-visual-title {
    position: relative;
    z-index: 2;
    color: #078447;
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 12px;
    text-align: center;
  }

  .fb-visual-text {
    position: relative;
    z-index: 2;
    color: #4b7562;
    font-size: 18px;
    margin: 0;
    text-align: center;
  }

  /* Statistics */

  .fb-stats {
    max-width: 1350px;
    margin: -10px auto 70px;
    padding: 0 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    position: relative;
    z-index: 5;
  }

  .fb-stat {
    background: white;
    border: 1px solid #d9e9e1;
    border-radius: 18px;
    padding: 32px 20px;
    text-align: center;
    box-shadow: 0 5px 18px rgba(0,0,0,0.04);
  }

  .fb-stat-number {
    display: block;
    color: #07904d;
    font-size: 38px;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .fb-stat-label {
    color: #537064;
    font-size: 18px;
  }

  /* Features */

  .fb-features {
    background: white;
    padding: 70px 50px;
  }

  .fb-section-title {
    text-align: center;
    color: #123d2b;
    font-size: 40px;
    margin: 0 0 15px;
  }

  .fb-section-subtitle {
    text-align: center;
    color: #61796e;
    font-size: 18px;
    margin: 0 auto 45px;
  }

  .fb-feature-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .fb-feature {
    border: 1px solid #dcebe3;
    border-radius: 18px;
    padding: 30px;
    background: #fbfffd;
  }

  .fb-feature-icon {
    width: 55px;
    height: 55px;
    border-radius: 12px;
    background: #dff5e8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 27px;
    margin-bottom: 20px;
  }

  .fb-feature h3 {
    margin: 0 0 10px;
    font-size: 21px;
    color: #123d2b;
  }

  .fb-feature p {
    margin: 0;
    color: #60786d;
    line-height: 1.6;
    font-size: 16px;
  }

  /* Mobile */

  @media (max-width: 1000px) {
    .fb-hero {
      grid-template-columns: 1fr;
      padding: 60px 35px;
    }

    .fb-title {
      font-size: 58px;
    }

    .fb-visual {
      height: 430px;
    }

    .fb-stats {
      grid-template-columns: 1fr;
      margin-top: 0;
    }

    .fb-feature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .fb-hero {
      padding: 40px 20px;
    }

    .fb-title {
      font-size: 43px;
    }

    .fb-description {
      font-size: 17px;
    }

    .fb-buttons {
      flex-direction: column;
    }

    .fb-btn {
      width: 100%;
    }

    .fb-visual {
      height: 360px;
    }

    .fb-food-box,
    .fb-food-bowl {
      width: 90px;
      height: 80px;
      font-size: 40px;
    }

    .fb-visual-title {
      font-size: 21px;
    }

    .fb-visual-text {
      font-size: 15px;
    }

    .fb-features {
      padding: 50px 20px;
    }
  }
</style>


<div class="fb-home">

  <!-- HERO -->
  <section class="fb-hero">

    <div class="fb-hero-content">

      <div class="fb-badge">
        SMART FOOD REDISTRIBUTION PLATFORM
