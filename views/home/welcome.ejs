<!-- ================= FOODBRIDGE HOME PAGE ================= -->

<style>
    * {
        box-sizing: border-box;
    }

   .home-page {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    background: #f5fbf7;
    color: #123d2b;
    overflow: hidden;
}

    /* ================= HERO ================= */

    .hero {
        min-height: 650px;
        padding: 75px 7% 65px;

        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 60px;

        background:
            radial-gradient(circle at 90% 20%, rgba(30, 180, 95, 0.12), transparent 35%),
            #f5fbf7;
    }

    .hero-content {
        max-width: 650px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 9px 16px;

        background: #dff5e8;
        color: #087f43;

        border-radius: 30px;

        font-size: 13px;
        font-weight: 700;

        margin-bottom: 25px;
    }

    .hero-badge span {
        width: 8px;
        height: 8px;

        background: #119447;
        border-radius: 50%;
    }

    .hero h1 {
        margin: 0;

        font-size: clamp(48px, 6vw, 76px);
        line-height: 1.02;

        letter-spacing: -2.5px;

        color: #123d2b;
    }

    .hero h1 .green {
        color: #119447;
    }

    .hero-description {
        max-width: 590px;

        margin: 27px 0 32px;

        color: #60766b;

        font-size: 18px;
        line-height: 1.7;
    }

    .hero-buttons {
        display: flex;
        align-items: center;
        gap: 14px;

        flex-wrap: wrap;
    }

    .primary-btn,
    .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 155px;

        padding: 14px 24px;

        border-radius: 9px;

        text-decoration: none;

        font-size: 15px;
        font-weight: 700;

        transition: 0.2s ease;
    }

    .primary-btn {
        background: #108d4b;
        color: #ffffff;
    }

    .primary-btn:hover {
        background: #087d43;
        transform: translateY(-2px);
    }

    .secondary-btn {
        background: #ffffff;
        color: #087f43;

        border: 1.5px solid #108d4b;
    }

    .secondary-btn:hover {
        background: #eaf8f0;
        transform: translateY(-2px);
    }

    /* ================= HERO VISUAL ================= */

    .hero-visual {
        position: relative;
        min-height: 480px;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .visual-card {
        width: min(440px, 100%);
        min-height: 420px;

        background: #dff5e8;

        border-radius: 35px;

        position: relative;

        display: flex;
        align-items: center;
        justify-content: center;

        box-shadow: 0 25px 55px rgba(25, 100, 55, 0.10);
    }

    .food-circle {
        width: 245px;
        height: 245px;

        background: #ffffff;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 125px;

        box-shadow: 0 20px 40px rgba(20, 80, 45, 0.12);
    }

    .floating-card {
        position: absolute;

        background: #ffffff;

        padding: 16px 19px;

        border-radius: 13px;

        box-shadow: 0 12px 35px rgba(20, 80, 45, 0.13);

        display: flex;
        align-items: center;
        gap: 11px;
    }

    .floating-card strong {
        display: block;
        color: #123d2b;
        font-size: 14px;
    }

    .floating-card small {
        color: #71847b;
        font-size: 11px;
    }

    .floating-icon {
        width: 38px;
        height: 38px;

        border-radius: 10px;

        background: #dff5e8;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 19px;
    }

    .card-one {
        left: -25px;
        top: 65px;
    }

    .card-two {
        right: -25px;
        bottom: 65px;
    }

    /* ================= STATS ================= */

    .stats {
        background: #ffffff;

        padding: 45px 7%;

        border-top: 1px solid #e7eee9;
        border-bottom: 1px solid #e7eee9;
    }

    .stats-grid {
        max-width: 1200px;
        margin: auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 20px;
    }

    .stat {
        text-align: center;

        padding: 15px;
    }

    .stat h2 {
        margin: 0 0 7px;

        font-size: 34px;
        color: #108d4b;
    }

    .stat p {
        margin: 0;

        color: #71847b;
        font-size: 14px;
    }

    /* ================= INTRO ================= */

    .intro {
        padding: 90px 7%;

        background: #f5fbf7;
    }

    .section-heading {
        max-width: 720px;
        margin: 0 auto 55px;

        text-align: center;
    }

    .section-label {
        color: #108d4b;

        font-size: 13px;
        font-weight: 800;

        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .section-heading h2 {
        margin: 12px 0 15px;

        color: #123d2b;

        font-size: 42px;
        line-height: 1.15;
    }

    .section-heading p {
        margin: 0;

        color: #6a7e74;

        font-size: 16px;
        line-height: 1.7;
    }

    /* ================= FEATURES ================= */

    .features-grid {
        max-width: 1150px;
        margin: auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 22px;
    }

    .feature-card {
        background: #ffffff;

        border: 1px solid #e3ece7;

        border-radius: 18px;

        padding: 30px;

        transition: 0.2s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);

        box-shadow: 0 15px 35px rgba(20, 80, 45, 0.08);
    }

    .feature-icon {
        width: 54px;
        height: 54px;

        background: #dff5e8;
        color: #108d4b;

        border-radius: 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 25px;

        margin-bottom: 22px;
    }

    .feature-card h3 {
        margin: 0 0 10px;

        color: #123d2b;

        font-size: 19px;
    }

    .feature-card p {
        margin: 0;

        color: #71847b;

        font-size: 14px;
        line-height: 1.7;
    }

    /* ================= HOW IT WORKS ================= */

    .process {
        padding: 90px 7%;

        background: #ffffff;
    }

    .process-grid {
        max-width: 1100px;
        margin: auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 30px;
    }

    .process-card {
        text-align: center;

        padding: 25px;
    }

    .process-number {
        width: 58px;
        height: 58px;

        margin: 0 auto 20px;

        border-radius: 50%;

        background: #108d4b;
        color: #ffffff;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 20px;
        font-weight: 800;
    }

    .process-card h3 {
        margin: 0 0 10px;

        font-size: 19px;
        color: #123d2b;
    }

    .process-card p {
        margin: 0;

        color: #71847b;

        font-size: 14px;
        line-height: 1.7;
    }

    /* ================= CTA ================= */

    .cta {
        padding: 75px 7%;

        background: #dff5e8;
    }

    .cta-box {
        max-width: 1050px;
        margin: auto;

        text-align: center;
    }

    .cta-box h2 {
        margin: 0 0 15px;

        color: #123d2b;

        font-size: 42px;
    }

    .cta-box p {
        max-width: 650px;
        margin: 0 auto 28px;

        color: #5f756a;

        font-size: 16px;
        line-height: 1.7;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 950px) {

        .hero {
            grid-template-columns: 1fr;
            padding-top: 55px;
        }

        .hero-content {
            max-width: 750px;
            margin: auto;
            text-align: center;
        }

        .hero-description {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            justify-content: center;
        }

        .hero-visual {
            min-height: 430px;
        }

        .features-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 650px) {

        .hero {
            padding: 45px 5%;
        }

        .hero h1 {
            font-size: 48px;
            letter-spacing: -1.5px;
        }

        .hero-description {
            font-size: 16px;
        }

        .visual-card {
            min-height: 350px;
        }

        .food-circle {
            width: 190px;
            height: 190px;
            font-size: 95px;
        }

        .card-one {
            left: 0;
            top: 35px;
        }

        .card-two {
            right: 0;
            bottom: 35px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .intro,
        .process {
            padding: 65px 5%;
        }

        .section-heading h2,
        .cta-box h2 {
            font-size: 32px;
        }

        .features-grid,
        .process-grid {
            grid-template-columns: 1fr;
        }

        .cta {
            padding: 60px 5%;
        }
    }
</style>


