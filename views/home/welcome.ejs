    </div>

  </section>


  <!-- FEATURES -->
  <section class="fb-features">

    <h2 class="fb-section-title">
      Why FoodBridge?
    </h2>

    <p class="fb-section-subtitle">
      Making food redistribution safe, transparent and meaningful.
    </p>


    <div class="fb-feature-grid">

      <div class="fb-feature">

        <div class="fb-feature-icon">
