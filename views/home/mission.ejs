        display: flex;
        align-items: center;
        gap: 12px;

        margin-bottom: 25px;
    }

    .verification-check {
        width: 45px;
        height: 45px;

        border-radius: 12px;

        background: #dff5e8;
        color: #108d4b;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 21px;
        font-weight: 800;
    }

    .verification-header strong {
        color: #123d2b;
        font-size: 15px;
    }

    .verification-header small {
        display: block;
        margin-top: 4px;
        color: #82938b;
        font-size: 11px;
    }

    .verification-row {
        display: flex;
        justify-content: space-between;

        padding: 12px 0;

        border-bottom: 1px solid #edf1ef;

        color: #60766b;
        font-size: 13px;
    }

    .verification-row:last-child {
        border-bottom: none;
    }

    .verified {
        color: #108d4b;
        font-weight: 700;
    }

    /* ================= ROLES ================= */

    .roles-section {
        padding: 85px 7%;
        background: #ffffff;
    }

    .roles-grid {
        max-width: 1050px;
        margin: auto;

