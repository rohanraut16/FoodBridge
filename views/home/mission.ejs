        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .role-card {
        padding: 32px;

        border: 1px solid #e2ece6;
        border-radius: 18px;

        background: #f9fcfa;
    }

    .role-icon {
        width: 55px;
        height: 55px;

        margin-bottom: 20px;

        border-radius: 14px;

        background: #dff5e8;
        color: #108d4b;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 24px;
    }

    .role-card h3 {
        margin: 0 0 10px;

        color: #123d2b;
        font-size: 19px;
    }

    .role-card p {
        margin: 0;

        color: #71847b;
        font-size: 14px;
        line-height: 1.7;
    }

    /* ================= CTA ================= */

    .works-cta {
        padding: 75px 7%;
        background: #dff5e8;
        text-align: center;
    }

    .works-cta h2 {
        margin: 0 0 14px;

        color: #123d2b;
        font-size: 38px;
    }

    .works-cta p {
        max-width: 650px;
        margin: 0 auto 28px;

        color: #60766b;
        font-size: 15px;
        line-height: 1.7;
    }

    .works-btn {
        display: inline-block;

        padding: 14px 25px;

        background: #108d4b;
        color: #ffffff;

        border-radius: 9px;

        text-decoration: none;

        font-size: 15px;
        font-weight: 700;
    }

    .works-btn:hover {
        background: #087d43;
    }

    @media (max-width: 850px) {

        .steps-grid {
            grid-template-columns: 1fr 1fr;
        }

        .safety-container {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {

        .steps-section,
        .safety-section,
        .roles-section {
            padding: 60px 5%;
        }

        .steps-grid,
        .roles-grid {
            grid-template-columns: 1fr;
        }

        .section-heading h2,
        .safety-content h2 {
            font-size: 31px;
        }

        .safety-visual {
            min-height: 320px;
        }
    }
</style>


