    .steps-section {
        padding: 85px 7%;
        background: #ffffff;
    }

    .section-heading {
        max-width: 720px;
        margin: 0 auto 55px;
        text-align: center;
    }

    .section-label {
        color: #108d4b;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .section-heading h2 {
        margin: 12px 0 15px;
        color: #123d2b;
        font-size: 40px;
        line-height: 1.2;
    }

    .section-heading p {
        margin: 0;
        color: #6a7e74;
        font-size: 15px;
        line-height: 1.7;
    }

    .steps-grid {
        max-width: 1150px;
        margin: auto;

        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .step-card {
        position: relative;

        padding: 32px 28px;

        background: #f8fcfa;

        border: 1px solid #e2ece6;
        border-radius: 18px;

        text-align: center;
    }

    .step-number {
        width: 62px;
        height: 62px;

        margin: 0 auto 22px;

        border-radius: 50%;

        background: #108d4b;
        color: #ffffff;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 19px;
        font-weight: 800;
    }

    .step-card h3 {
        margin: 0 0 12px;

        color: #123d2b;
        font-size: 19px;
    }

    .step-card p {
        margin: 0;

        color: #71847b;
        font-size: 14px;
        line-height: 1.7;
    }

    /* ================= SAFETY ================= */

    .safety-section {
        padding: 85px 7%;
        background: #f5fbf7;
    }

    .safety-container {
        max-width: 1150px;
        margin: auto;

        display: grid;
        grid-template-columns: 1fr 1fr;

        gap: 60px;

        align-items: center;
    }

    .safety-content h2 {
        margin: 12px 0 18px;

        font-size: 40px;
        line-height: 1.2;

        color: #123d2b;
    }

    .safety-content p {
        color: #6a7e74;
        font-size: 15px;
        line-height: 1.8;
    }

    .safety-list {
        margin-top: 25px;

        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .safety-item {
        display: flex;
        align-items: center;
        gap: 13px;

        color: #34594a;
        font-size: 14px;
        font-weight: 600;
    }

    .safety-icon {
        width: 38px;
        height: 38px;

        flex-shrink: 0;

        border-radius: 10px;

        background: #dff5e8;
        color: #108d4b;

        display: flex;
        align-items: center;
        justify-content: center;

        font-weight: 800;
    }

    .safety-visual {
        min-height: 380px;

        border-radius: 28px;

        background: #dff5e8;

        display: flex;
        align-items: center;
        justify-content: center;
