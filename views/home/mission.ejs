<style>
    .works-page {
        background: #f5fbf7;
        color: #123d2b;
    }

    .works-hero {
        padding: 85px 7% 75px;
        text-align: center;
        background: #dff5e8;
    }

    .works-badge {
        display: inline-block;
        padding: 9px 17px;
        border-radius: 30px;
        background: #c8eed8;
        color: #087f43;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .works-hero h1 {
        margin: 0 0 18px;
        font-size: clamp(42px, 5vw, 64px);
        line-height: 1.1;
        color: #123d2b;
    }

    .works-hero h1 span {
        color: #108d4b;
    }

    .works-hero p {
